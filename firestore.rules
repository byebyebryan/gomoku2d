rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profileWriteKeys() {
      return [
        'auth',
        'created_at',
        'display_name',
        'match_history',
        'reset_at',
        'schema_version',
        'settings',
        'uid',
        'updated_at',
        'username',
      ];
    }

    function validProfileKeys() {
      return request.resource.data.keys().hasAll(profileWriteKeys())
        && request.resource.data.keys().hasOnly(profileWriteKeys());
    }

    function nullableString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function hasResetAt(data) {
      return data.keys().hasAny(['reset_at']);
    }

    function validResetAtValue(data) {
      return hasResetAt(data)
        && (data.reset_at == null || data.reset_at is timestamp);
    }

    function validResetAtOnCreate() {
      return request.resource.data.reset_at == null
        || request.resource.data.reset_at == request.time;
    }

    function validResetAtOnUpdate() {
      return (
          !hasResetAt(resource.data)
          && request.resource.data.reset_at == null
        )
        || (
          hasResetAt(resource.data)
          && request.resource.data.reset_at == resource.data.reset_at
        )
        || (
          request.resource.data.reset_at == request.time
          && (
            !hasResetAt(resource.data)
            || resource.data.reset_at == null
            || request.resource.data.reset_at > resource.data.reset_at
          )
        );
    }

    function validAuthProvider(provider) {
      return provider is map
        && provider.keys().hasAll(['avatar_url', 'display_name', 'provider'])
        && provider.keys().hasOnly(['avatar_url', 'display_name', 'provider'])
        && nullableString(provider.avatar_url, 2048)
        && nullableString(provider.display_name, 80)
        && provider.provider in ['google.com', 'github.com'];
    }

    function validAuthProviders(providers) {
      return providers is list
        && providers.size() > 0
        && providers.size() <= 2
        && validAuthProvider(providers[0])
        && (providers.size() == 1 || validAuthProvider(providers[1]));
    }

    function validAuth(value) {
      return value is map
        && value.keys().hasAll(['providers'])
        && value.keys().hasOnly(['providers'])
        && validAuthProviders(value.providers);
    }

    function validGameConfig(value) {
      return value is map
        && value.keys().hasAll(['opening', 'ruleset'])
        && value.keys().hasOnly(['opening', 'ruleset'])
        && value.opening == 'standard'
        && value.ruleset in ['freestyle', 'renju'];
    }

    function validBotPreset(value) {
      return value is map
        && value.keys().hasAll(['mode', 'preset', 'version'])
        && value.keys().hasOnly(['mode', 'preset', 'version'])
        && value.version == 1
        && value.mode == 'preset'
        && value.preset in ['easy', 'normal', 'hard'];
    }

    function validBotCustom(value) {
      return value is map
        && value.keys().hasAll([
          'depth',
          'extra_pass',
          'mode',
          'scoring',
          'version',
          'width',
        ])
        && value.keys().hasOnly([
          'depth',
          'extra_pass',
          'mode',
          'scoring',
          'version',
          'width',
        ])
        && value.version == 1
        && value.mode == 'custom'
        && value.depth in [1, 3, 5, 7]
        && (value.width == 'full' || value.width == 8 || value.width == 16)
        && value.scoring in ['simple', 'pattern']
        && value.extra_pass in ['none', 'corridor_proof'];
    }

    function validBot(value) {
      return validBotPreset(value) || validBotCustom(value);
    }

    function validTouchControl(value) {
      return value in ['pointer', 'touchpad'];
    }

    function validBoardHints(value) {
      return value is map
        && value.keys().hasAll(['evidence', 'immediate', 'imminent'])
        && value.keys().hasOnly(['evidence', 'immediate', 'imminent'])
        && value.evidence in ['off', 'on']
        && value.immediate in ['off', 'win', 'win_threat']
        && value.imminent in ['off', 'threat', 'threat_counter'];
    }

    function validSettings(value) {
      return value is map
        && value.keys().hasAll(['board_hints', 'bot_config', 'game_config', 'touch_control'])
        && value.keys().hasOnly(['board_hints', 'bot_config', 'game_config', 'touch_control'])
        && validBoardHints(value.board_hints)
        && validBot(value.bot_config)
        && validGameConfig(value.game_config)
        && validTouchControl(value.touch_control);
    }

    function validMatchHistory(value) {
      return value is map
        && value.keys().hasAll(['archived_stats', 'replay_matches', 'summary_matches'])
        && value.keys().hasOnly(['archived_stats', 'replay_matches', 'summary_matches'])
        && value.replay_matches is list
        && value.replay_matches.size() <= 128
        && value.summary_matches is list
        && value.summary_matches.size() <= 1024
        && validArchivedMatchStats(value.archived_stats);
    }

    function validMatchHistoryOnCreate() {
      return request.resource.data.match_history.replay_matches.size() == 0
        && request.resource.data.match_history.summary_matches.size() == 0
        && emptyArchivedMatchStats(request.resource.data.match_history.archived_stats);
    }

    function validStatsCounter(value) {
      return value is map
        && value.keys().hasAll(['draws', 'losses', 'matches', 'moves', 'wins'])
        && value.keys().hasOnly(['draws', 'losses', 'matches', 'moves', 'wins'])
        && value.draws is int
        && value.draws >= 0
        && value.losses is int
        && value.losses >= 0
        && value.matches is int
        && value.matches >= 0
        && value.moves is int
        && value.moves >= 0
        && value.wins is int
        && value.wins >= 0;
    }

    function validArchivedMatchStats(value) {
      return value is map
        && value.keys().hasAll([
          'archived_before',
          'archived_count',
          'by_opponent_type',
          'by_ruleset',
          'by_side',
          'schema_version',
          'totals',
        ])
        && value.keys().hasOnly([
          'archived_before',
          'archived_count',
          'by_opponent_type',
          'by_ruleset',
          'by_side',
          'schema_version',
          'totals',
        ])
        && nullableString(value.archived_before, 40)
        && value.archived_count is int
        && value.archived_count >= 0
        && value.schema_version == 1
        && value.by_opponent_type is map
        && value.by_opponent_type.keys().hasAll(['bot', 'human'])
        && value.by_opponent_type.keys().hasOnly(['bot', 'human'])
        && value.by_ruleset is map
        && value.by_ruleset.keys().hasAll(['freestyle', 'renju'])
        && value.by_ruleset.keys().hasOnly(['freestyle', 'renju'])
        && value.by_side is map
        && value.by_side.keys().hasAll(['black', 'white'])
        && value.by_side.keys().hasOnly(['black', 'white'])
        && validStatsCounter(value.totals);
    }

    function emptyArchivedMatchStats(value) {
      return value.archived_before == null
        && value.archived_count == 0;
    }

    function validProfileDocument(uid) {
      return validProfileKeys()
        && request.resource.data.schema_version == 5
        && request.resource.data.uid == uid
        && request.resource.data.uid is string
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() > 0
        && request.resource.data.display_name.size() <= 80
        && nullableString(request.resource.data.username, 40)
        && validAuth(request.resource.data.auth)
        && validSettings(request.resource.data.settings)
        && validResetAtValue(request.resource.data)
        && validMatchHistory(request.resource.data.match_history)
        && request.resource.data.created_at is timestamp
        && request.resource.data.updated_at is timestamp;
    }

    function appOwnedProfileFieldsUnchanged() {
      return request.resource.data.created_at == resource.data.created_at
        && request.resource.data.username == resource.data.username;
    }

    function profileUpdateCooldownPassed() {
      return request.time >= resource.data.updated_at + duration.value(5, 'm');
    }

    function profileResetCooldownPassed() {
      return !hasResetAt(resource.data)
        || resource.data.reset_at == null
        || request.time >= resource.data.reset_at + duration.value(5, 'm');
    }

    function profileResetCooldownBypass() {
      return request.resource.data.reset_at == request.time
        && (
          !hasResetAt(resource.data)
          || resource.data.reset_at == null
          || request.resource.data.reset_at > resource.data.reset_at
        )
        && profileResetCooldownPassed()
        && validMatchHistoryOnCreate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileWriteKeys());
    }

    function initialProfileSyncBypass() {
      return resource.data.created_at == resource.data.updated_at
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileWriteKeys());
    }

    // This literal is the operational switch for directory reads and new
    // publication. Setting it to false hides public data while retaining the
    // owner-only paths needed to disable and clear accounts.
    function publicSharingEnabled() {
      return true;
    }

    function validSharingRevision(value) {
      return value is int && value >= 1 && value <= 2147483647;
    }

    function validSharingUid(uid) {
      return uid is string && uid.size() > 0 && uid.size() <= 128;
    }

    function publicProfilePath(uid) {
      return /databases/$(database)/documents/public_profiles/$(uid);
    }

    function publicCatalogPagePath(uid, pageId) {
      return /databases/$(database)/documents/public_profiles/$(uid)/pages/$(pageId);
    }

    function validPublicProfileDocument(uid, data) {
      return data is map
        && data.keys().hasAll([
          'schema_version', 'uid', 'display_name', 'enabled', 'generation', 'revision', 'updated_at',
        ])
        && data.keys().hasOnly([
          'schema_version', 'uid', 'display_name', 'enabled', 'generation', 'revision', 'updated_at',
          'shared_stats', 'catalog_page_counts',
        ])
        && data.schema_version == 1
        && data.uid == uid
        && validSharingUid(data.uid)
        && data.display_name is string
        && data.enabled is bool
        && (data.enabled ? data.display_name.matches('^.{1,80}$') : data.display_name == '')
        && validSharingRevision(data.generation)
        && validSharingRevision(data.revision)
        && (!('shared_stats' in data) || data.shared_stats == null || validPublicStats(data.shared_stats))
        && (!('shared_stats' in data) || data.shared_stats == null || data.enabled)
        && (!('catalog_page_counts' in data) || validPublicCatalogPageCounts(data.catalog_page_counts))
        && data.updated_at is timestamp
        && data.updated_at == request.time;
    }

    function validPublicStats(value) {
      return value is map
        && value.keys().hasAll(['matches', 'wins', 'losses', 'draws', 'updated_at'])
        && value.keys().hasOnly(['matches', 'wins', 'losses', 'draws', 'updated_at'])
        && value.matches is int && value.matches >= 0 && value.matches <= 2147483647
        && value.wins is int && value.wins >= 0 && value.wins <= 2147483647
        && value.losses is int && value.losses >= 0 && value.losses <= 2147483647
        && value.draws is int && value.draws >= 0 && value.draws <= 2147483647
        && value.matches == value.wins + value.losses + value.draws
        && value.updated_at is timestamp;
    }

    function validPublicCatalogPageCounts(value) {
      return value is list
        && value.size() == 4
        && value[0] is int && value[0] >= 0 && value[0] <= 8
        && value[1] is int && value[1] >= 0 && value[1] <= 8
        && value[2] is int && value[2] >= 0 && value[2] <= 8
        && value[3] is int && value[3] >= 0 && value[3] <= 8;
    }

    function validPublicCatalogEntry(entry) {
      return entry is map
        && entry.keys().hasOnly(['fingerprint', 'payload', 'title', 'view_ply'])
        && entry.fingerprint.matches('^[A-Za-z0-9_-]{43}$')
        && entry.payload.size() <= 8192
        && entry.payload.matches('^[A-Za-z0-9_-]+$')
        && validPublicCatalogTitle(entry.title)
        && entry.view_ply is int
        && entry.view_ply >= 0
        && entry.view_ply <= 225;
    }

    function validPublicCatalogTitle(value) {
      return value.matches('^[ -~]*$')
        ? value.size() <= 80
        : value.matches('^.{0,80}$');
    }

    function validPublicCatalogEntries(entries) {
      return entries is list
        && entries.size() <= 8
        && (entries.size() < 1 || validPublicCatalogEntry(entries[0]))
        && (entries.size() < 2 || validPublicCatalogEntry(entries[1]))
        && (entries.size() < 3 || validPublicCatalogEntry(entries[2]))
        && (entries.size() < 4 || validPublicCatalogEntry(entries[3]))
        && (entries.size() < 5 || validPublicCatalogEntry(entries[4]))
        && (entries.size() < 6 || validPublicCatalogEntry(entries[5]))
        && (entries.size() < 7 || validPublicCatalogEntry(entries[6]))
        && (entries.size() < 8 || validPublicCatalogEntry(entries[7]));
    }

    function validPublicCatalogPageDocument(data) {
      return data is map
        && data.keys().hasAll(['schema_version', 'generation', 'revision', 'updated_at', 'entries'])
        && data.keys().hasOnly(['schema_version', 'generation', 'revision', 'updated_at', 'entries'])
        && data.schema_version == 1
        && validSharingRevision(data.generation)
        && validSharingRevision(data.revision)
        && data.updated_at is timestamp
        && data.updated_at == request.time
        && validPublicCatalogEntries(data.entries);
    }

    function validEmptyCatalogPageAfter(uid, pageId, generation) {
      let path = publicCatalogPagePath(uid, pageId);
      let page = getAfter(path).data;
      return existsAfter(path)
        && page.generation == generation
        && page.entries is list
        && page.entries.size() == 0;
    }

    function allPublicCatalogPagesClearedAfter(uid, generation) {
      return validEmptyCatalogPageAfter(uid, '0', generation)
        && validEmptyCatalogPageAfter(uid, '1', generation)
        && validEmptyCatalogPageAfter(uid, '2', generation)
        && validEmptyCatalogPageAfter(uid, '3', generation);
    }

    function publicCatalogCountsMatchAfter(uid, counts, generation) {
      let pagesAfter = [
        getAfter(publicCatalogPagePath(uid, '0')).data,
        getAfter(publicCatalogPagePath(uid, '1')).data,
        getAfter(publicCatalogPagePath(uid, '2')).data,
        getAfter(publicCatalogPagePath(uid, '3')).data,
      ];
      let pagesBefore = [
        get(publicCatalogPagePath(uid, '0')).data,
        get(publicCatalogPagePath(uid, '1')).data,
        get(publicCatalogPagePath(uid, '2')).data,
        get(publicCatalogPagePath(uid, '3')).data,
      ];
      return validPublicCatalogPageCounts(counts)
        && existsAfter(publicCatalogPagePath(uid, '0')) && pagesAfter[0].generation == generation && pagesAfter[0].entries.size() == counts[0]
        && existsAfter(publicCatalogPagePath(uid, '1')) && pagesAfter[1].generation == generation && pagesAfter[1].entries.size() == counts[1]
        && existsAfter(publicCatalogPagePath(uid, '2')) && pagesAfter[2].generation == generation && pagesAfter[2].entries.size() == counts[2]
        && existsAfter(publicCatalogPagePath(uid, '3')) && pagesAfter[3].generation == generation && pagesAfter[3].entries.size() == counts[3]
        && (pagesAfter[0].revision == pagesBefore[0].revision + 1
          || pagesAfter[1].revision == pagesBefore[1].revision + 1
          || pagesAfter[2].revision == pagesBefore[2].revision + 1
          || pagesAfter[3].revision == pagesBefore[3].revision + 1);
    }

    function publicCatalogManifestUpdateValid(uid) {
      let beforeHasCounts = 'catalog_page_counts' in resource.data;
      let afterHasCounts = 'catalog_page_counts' in request.resource.data;
      return (!beforeHasCounts || afterHasCounts)
        && (
          (beforeHasCounts == afterHasCounts
            && (!beforeHasCounts || request.resource.data.catalog_page_counts == resource.data.catalog_page_counts))
          || (afterHasCounts
            && publicCatalogCountsMatchAfter(
              uid,
              request.resource.data.catalog_page_counts,
              request.resource.data.generation,
            ))
        );
    }

    function publicSharedStatsUpdateValid() {
      let beforeHasStats = 'shared_stats' in resource.data;
      let afterHasStats = 'shared_stats' in request.resource.data;
      return (beforeHasStats && !afterHasStats) == false
        && (
          !afterHasStats
          || request.resource.data.shared_stats == null
          || (beforeHasStats && request.resource.data.shared_stats == resource.data.shared_stats)
          || (publicSharingEnabled() && request.resource.data.shared_stats.updated_at == request.time)
        );
    }

    function publicProfilePageMutationMatchesAfter(uid, pageId, entries) {
      let root = publicProfilePath(uid);
      let profileBefore = get(root).data;
      let profileAfter = getAfter(root).data;
      let pageIndex = pageId == '0' ? 0 : pageId == '1' ? 1 : pageId == '2' ? 2 : 3;
      return existsAfter(root)
        && profileAfter.enabled == true
        && profileAfter.generation == resource.data.generation
        && profileAfter.revision == profileBefore.revision + 1
        && (
          !('catalog_page_counts' in profileAfter)
          || (validPublicCatalogPageCounts(profileAfter.catalog_page_counts)
            && profileAfter.catalog_page_counts[pageIndex] == entries.size())
        );
    }

    function publicProfilePageCreateMatchesAfter(uid, pageId, page) {
      let root = publicProfilePath(uid);
      let profileAfter = getAfter(root).data;
      let pageIndex = pageId == '0' ? 0 : pageId == '1' ? 1 : pageId == '2' ? 2 : 3;
      return existsAfter(root)
        && profileAfter.generation == page.generation
        && validPublicCatalogPageCounts(profileAfter.catalog_page_counts)
        && profileAfter.catalog_page_counts[pageIndex] == page.entries.size();
    }

    function publicProfilePageClearMatchesAfter(uid, page) {
      let root = publicProfilePath(uid);
      let profileBefore = get(root).data;
      let profileAfter = getAfter(root).data;
      return existsAfter(root)
        && profileAfter.generation == resource.data.generation + 1
        && profileAfter.revision == profileBefore.revision + 1
        && profileAfter.shared_stats == null
        && profileAfter.catalog_page_counts == [0, 0, 0, 0]
        && page.generation == profileAfter.generation
        && page.entries.size() == 0;
    }

    function publicProfileGenerationMatchesAfter(uid, generation) {
      let path = publicProfilePath(uid);
      let profileAfter = getAfter(path).data;
      return existsAfter(path)
        && profileAfter.uid == uid
        && profileAfter.schema_version == 1
        && profileAfter.generation == generation;
    }

    function validPrivateLibraryDocument(uid, data) {
      return data is map
        && data.keys().hasAll(['schema_version', 'uid', 'revision', 'updated_at', 'entries_json'])
        && data.keys().hasOnly(['schema_version', 'uid', 'revision', 'updated_at', 'entries_json'])
        && data.schema_version == 1
        && data.uid == uid
        && validSharingUid(data.uid)
        && validSharingRevision(data.revision)
        && data.updated_at is timestamp
        && data.updated_at == request.time
        && data.entries_json is string
        && data.entries_json.size() <= 600000
        && data.entries_json.matches('^[ -~]*$');
    }

    // Older clients cannot report cloud deletion complete while new sharing
    // families still contain personal data. The current client clears them first.
    function sharingDataClearedBeforeProfileDelete(uid) {
      let root = publicProfilePath(uid);
      let library = /databases/$(database)/documents/replay_libraries/$(uid);
      return (!exists(root) || (get(root).data.enabled == false
        && get(root).data.display_name == ''
        && (!('shared_stats' in get(root).data) || get(root).data.shared_stats == null)))
        && (!exists(library) || get(library).data.entries_json == '[]');
    }

    match /profiles/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && validProfileDocument(uid)
        && request.resource.data.username == null
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time
        && validMatchHistoryOnCreate()
        && validResetAtOnCreate();
      allow update: if isOwner(uid)
        && validProfileDocument(uid)
        && appOwnedProfileFieldsUnchanged()
        && request.resource.data.updated_at == request.time
        && (
          profileUpdateCooldownPassed()
          || profileResetCooldownBypass()
          || initialProfileSyncBypass()
        )
        && validResetAtOnUpdate();
      allow delete: if isOwner(uid) && sharingDataClearedBeforeProfileDelete(uid);

      match /matches/{matchId} {
        allow read, write: if false;
      }
    }

    match /public_profiles/{uid} {
      allow get: if isOwner(uid)
        || (publicSharingEnabled() && resource != null && resource.data.enabled == true);
      allow list: if false;
      allow create: if isOwner(uid)
        && validPublicProfileDocument(uid, request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.generation == 1
        && request.resource.data.shared_stats == null
        && request.resource.data.catalog_page_counts == [0, 0, 0, 0]
        && (!request.resource.data.enabled || publicSharingEnabled())
        && allPublicCatalogPagesClearedAfter(uid, 1);
      allow update: if isOwner(uid)
        && validPublicProfileDocument(uid, request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.schema_version == resource.data.schema_version
        && request.resource.data.revision == resource.data.revision + 1
        && publicCatalogManifestUpdateValid(uid)
        && publicSharedStatsUpdateValid()
        && (
          (
            request.resource.data.generation == resource.data.generation
            && request.resource.data.enabled == resource.data.enabled
          )
          || (
            request.resource.data.generation == resource.data.generation + 1
            && (
              request.resource.data.enabled != resource.data.enabled
              || (!resource.data.enabled && !request.resource.data.enabled)
            )
            && (!request.resource.data.enabled || publicSharingEnabled())
            && request.resource.data.shared_stats == null
            && request.resource.data.catalog_page_counts == [0, 0, 0, 0]
            && allPublicCatalogPagesClearedAfter(uid, request.resource.data.generation)
          )
        );
      allow delete: if false;

      match /pages/{pageId} {
        allow get: if isOwner(uid)
          || (
            publicSharingEnabled()
            && resource != null
            && exists(publicProfilePath(uid))
            && get(publicProfilePath(uid)).data.enabled == true
            && resource.data.generation == get(publicProfilePath(uid)).data.generation
          );
        allow list: if false;
        allow create: if isOwner(uid)
          && pageId in ['0', '1', '2', '3']
          && validPublicCatalogPageDocument(request.resource.data)
          && request.resource.data.revision == 1
          && request.resource.data.entries.size() == 0
          && publicProfilePageCreateMatchesAfter(uid, pageId, request.resource.data)
          && publicProfileGenerationMatchesAfter(uid, request.resource.data.generation);
        allow update: if isOwner(uid)
          && pageId in ['0', '1', '2', '3']
          && validPublicCatalogPageDocument(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1
          && (
            (
              request.resource.data.generation == resource.data.generation
              && publicProfilePageMutationMatchesAfter(uid, pageId, request.resource.data.entries)
              && (request.resource.data.entries.size() == 0 || publicSharingEnabled())
            )
            || (
              request.resource.data.generation == resource.data.generation + 1
              && request.resource.data.entries.size() == 0
              && publicProfilePageClearMatchesAfter(uid, request.resource.data)
            )
          );
        allow delete: if false;
      }
    }

    match /replay_libraries/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
        && validPrivateLibraryDocument(uid, request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if isOwner(uid)
        && validPrivateLibraryDocument(uid, request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.schema_version == resource.data.schema_version
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
